{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux",
  "version": "0.2.0",
  "identifier": "io.blade.flux",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flux",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "visible": true,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "assets/flux.png",
      "assets/flux.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MTcwMTU1ODhFQTUzOEQKUldTTlUrcUlWUUVYRlk4QUhFL3N0NU11U2RYM3RTa1ZXOEdaR2N6aTNlcTA3UzRlbXFTWnI4ODgK",
      "endpoints": [
        "https://github.com/Blad3Mak3r/flux/releases/latest/download/latest.json"
      ]
    }
  }
}
