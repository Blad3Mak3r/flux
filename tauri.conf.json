{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux",
  "version": "0.2.0",
  "identifier": "io.blade.flux",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flux",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "visible": true,
        "decorations": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "assets/flux.png",
      "assets/flux.ico"
    ]
  }
}
