{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux Timecode",
  "version": "0.1.0",
  "identifier": "com.fluxtimecode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Flux Timecode",
        "url": "index.html?view=launcher",
        "width": 440,
        "height": 330,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false
      },
      {
        "label": "welcome",
        "title": "Flux Timecode",
        "width": 760,
        "height": 520,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "create": false
      },
      {
        "label": "main",
        "title": "Flux Timecode",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MkFDRkZBNTM5QjZERDkKUldUWmJadFQrczhxUmtWWEE5STdFU3QxNjdSWVZtYVRUOTRLQ3NCaWxMdW1IL21HNHl6aDJ1RGcK",
      "endpoints": [
        "https://fxtc.blademaker.tv/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Spanish"],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": { "depends": ["libasound2t64 | libasound2"] },
      "rpm": { "depends": ["alsa-lib", "gtk3", "webkit2gtk4.1"] }
    },
    "fileAssociations": [
      {
        "ext": ["fxtc"],
        "name": "Flux Timecode project",
        "description": "Flux Timecode project",
        "mimeType": "application/x-fxtc",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
