{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux Timecode",
  "version": "0.1.0",
  "identifier": "com.fluxtimecode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Flux Timecode",
        "url": "index.html?view=launcher",
        "width": 440,
        "height": 260,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "decorations": false
      },
      {
        "label": "welcome",
        "title": "Flux Timecode",
        "width": 760,
        "height": 520,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "alwaysOnTop": true,
        "decorations": false,
        "create": false
      },
      {
        "label": "main",
        "title": "Flux Timecode",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libpipewire-0.3-0"] },
      "rpm": { "depends": ["webkit2gtk4.1", "gtk3", "pipewire-libs"] }
    },
    "fileAssociations": [
      {
        "ext": ["fxtc"],
        "name": "Flux Timecode project",
        "description": "Flux Timecode project",
        "mimeType": "application/x-fxtc",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
